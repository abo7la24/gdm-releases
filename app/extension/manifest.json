{
  "manifest_version": 3,
  "name": "GDM Capture (Genius Download Manager)",
  "version": "0.1.0",
  "description": "Sends browser downloads and page media to the GDM app on this computer.",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "webRequest",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GDM"
  }
}